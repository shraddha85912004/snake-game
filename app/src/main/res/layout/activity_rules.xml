<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B5E20"
    android:gravity="center">

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rules_card_bg"
            android:padding="24dp">

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖  How to Play"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true" />

                <Button
                    android:id="@+id/btnCloseRules"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_rules_bg"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="0dp" />
            </RelativeLayout>

            <!-- Rules List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.  Tap PLAY to start your session."
                android:textColor="#E8F5E9"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.  Use the on-screen D-Pad (▲, ◀, ▶, ▼) to steer the snake."
                android:textColor="#E8F5E9"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.  Eat red apples (+1 pt) and green apples (+10 pts) to grow."
                android:textColor="#E8F5E9"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4.  Watch out for bombs — hitting a bomb decreases your score by 1 point!"
                android:textColor="#E8F5E9"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5.  Avoid crashing into the outer boundary walls or your own tail."
                android:textColor="#E8F5E9"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6.  Speed increases automatically as your snake grows longer!"
                android:textColor="#E8F5E9"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7.  Score as high as you can and claim #1 on the Leaderboard! 🏆"
                android:textColor="#FFF59D"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <!-- Continue Button -->
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/btn_play_bg"
        android:text="CONTINUE  ▶"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

</LinearLayout>

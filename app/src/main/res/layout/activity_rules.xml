<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2E7D32"
    android:gravity="center">

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rules_card_bg"
            android:padding="24dp">

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to Play"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_centerVertical="true" />

                <Button
                    android:id="@+id/btnCloseRules"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:backgroundTint="#FF9800"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="0dp" />
            </RelativeLayout>

            <!-- Rules List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.  Tap Play to start the game."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.  Use the D-Pad buttons to move the snake Up, Down, Left, or Right."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.  Collect apples to grow your snake and increase your score."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4.  Watch out for bombs — they appear after a countdown warning!"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5.  Avoid hitting the walls or your own body."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6.  The game ends if you crash into a wall, bomb, or yourself."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7.  Score as high as you can and climb the leaderboard!"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Continue Button -->
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#1B5E20"
        android:text="CONTINUE"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

</LinearLayout>
